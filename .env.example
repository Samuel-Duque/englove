# ==============================================================================
# Englove — Variables de entorno de ejemplo (.env.example)
# Conforme a SPEC-01 Scaffold §5
# Copia este archivo a .env para desarrollo local: cp .env.example .env
# NUNCA agregues credenciales de produccion ni secretos en este archivo.
# ==============================================================================

# Entorno de la aplicacion (local | staging | production)
APP_ENV=local
PORT=3001

# Base de datos (PostgreSQL 18 en Neon / local docker-compose puerto 5433)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/englove_dev?schema=public"
# guardrails-ignore G-A03: documentacion de conexion directa en .env.example para migraciones (SPEC-01 §5)
MIGRATION_DATABASE_URL="postgresql://postgres:postgres@localhost:5433/englove_dev?schema=public"

# Almacenamiento de archivos (Cloudflare R2 con compatibilidad S3 / MinIO local en puerto 9000)
R2_ACCOUNT_ID=local
R2_ACCESS_KEY_ID=minioadmin
R2_SECRET_ACCESS_KEY=minioadmin
R2_BUCKET_NAME=englove-dev
R2_ENDPOINT=http://localhost:9000
R2_PUBLIC_URL=http://localhost:9000/englove-dev

# Cookies de sesion y alcance de dominio (vacio en local; .englove.org en staging/prod)
COOKIE_DOMAIN=
COOKIE_PREFIX=englove_local_
NEXT_PUBLIC_COOKIE_PREFIX=englove_local_

# Origenes de aplicacion web y API
WEB_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# Correo transaccional (Resend en staging/prod; Mailpit SMTP en local puerto 1025)
MAIL_FROM="Englove <notificaciones@englove.org>"
SMTP_HOST=localhost
SMTP_PORT=1025
MAILPIT_API_URL=http://localhost:8025
# RESEND_API_KEY no se requiere en local (opera en modo Mailpit SMTP / log seguro).
# Obligatoria en staging y production.
RESEND_API_KEY=

# Secreto JWT (minimo 32 caracteres; obligatorio y no puede usar el valor de desarrollo en staging/prod)
JWT_SECRET=englove-dev-jwt-secret-min-32-chars-long-local-secret!
