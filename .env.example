# ==============================================================================
# Englove — Variables de entorno de ejemplo (.env.example)
# Conforme a SPEC-01 Scaffold §5
# Copia este archivo a .env para desarrollo local: cp .env.example .env
# NUNCA agregues credenciales de produccion ni secretos en este archivo.
# ==============================================================================

# Entorno de la aplicacion (local | staging | production)
APP_ENV=local
PORT=3001

# Base de datos (PostgreSQL 18 en Neon)
# En local se usa la instancia de docker-compose
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/englove_dev?schema=public"
# guardrails-ignore G-A03: documentacion de conexion directa en .env.example para migraciones (SPEC-01 §5)
MIGRATION_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/englove_dev?schema=public"

# Almacenamiento de archivos (Cloudflare R2 con compatibilidad S3)
R2_ACCOUNT_ID=placeholder_account_id
R2_ACCESS_KEY_ID=placeholder_access_key
R2_SECRET_ACCESS_KEY=placeholder_secret_key
R2_BUCKET_NAME=englove-dev
R2_PUBLIC_URL=

# Cookies de sesion y alcance de dominio (vacio en local; .englove.org en staging/prod)
COOKIE_DOMAIN=
COOKIE_PREFIX=englove_local_

# Origenes de aplicacion web y API
WEB_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# Correo transaccional (Resend)
MAIL_FROM="Englove <notificaciones@englove.org>"
# RESEND_API_KEY no se requiere en local (opera en modo log seguro).
# Obligatoria en staging y production.
RESEND_API_KEY=
