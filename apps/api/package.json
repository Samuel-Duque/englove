{
  "name": "@englove/api",
  "version": "0.0.1",
  "private": true,
  "files": ["dist", "prisma"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "nest start --watch -p tsconfig.build.json",
    "start": "node dist/src/main.js",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "seed": "tsx prisma/seeds/seed.ts",
    "seed:dev": "tsx prisma/seeds/seed-dev.ts",
    "seed:volume": "tsx prisma/seeds/seed-volume.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.750.0",
    "@aws-sdk/s3-request-presigner": "^3.750.0",
    "@englove/shared": "workspace:*",
    "@nestjs/common": "^11.0.11",
    "@nestjs/config": "^4.0.1",
    "@nestjs/core": "^11.0.11",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/platform-express": "^11.0.11",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/swagger": "^11.0.6",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.0.0",
    "argon2": "^0.41.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "nestjs-pino": "^4.3.1",
    "pg": "^8.23.1",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "reflect-metadata": "^0.2.2",
    "resend": "^4.1.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@englove/eslint-config": "workspace:*",
    "@englove/prettier-config": "workspace:*",
    "@englove/tsconfig": "workspace:*",
    "@nestjs/cli": "^12.0.11",
    "@prisma/config": "^7.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "eslint": "^9.21.0",
    "prisma": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "~5.9.3",
    "vitest": "^3.0.7"
  }
}
