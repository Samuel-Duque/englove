{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "englove-web",
  "main": "vinext/server/fetch-handler",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "env": {
    "staging": {
      "name": "englove-web-staging",
      "vars": {
        "NEXT_PUBLIC_APP_ENV": "staging",
        "COOKIE_PREFIX": "englove_stg_",
        "NEXT_PUBLIC_COOKIE_PREFIX": "englove_stg_"
      }
    },
    "production": {
      "name": "englove-web-production",
      "vars": {
        "NEXT_PUBLIC_APP_ENV": "production",
        "COOKIE_PREFIX": "englove_",
        "NEXT_PUBLIC_COOKIE_PREFIX": "englove_"
      }
    }
  }
}
