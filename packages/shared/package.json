{
  "name": "@englove/shared",
  "version": "0.0.1",
  "private": true,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./enums": {
      "types": "./dist/enums.d.ts",
      "import": "./dist/enums.mjs",
      "require": "./dist/enums.js"
    },
    "./contract": {
      "types": "./dist/contract.d.ts",
      "import": "./dist/contract.mjs",
      "require": "./dist/contract.js"
    },
    "./activities": {
      "types": "./dist/activities/index.d.ts",
      "import": "./dist/activities/index.mjs",
      "require": "./dist/activities/index.js"
    },
    "./api": {
      "types": "./dist/api/index.d.ts",
      "import": "./dist/api/index.mjs",
      "require": "./dist/api/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@englove/tsconfig": "workspace:*",
    "@englove/eslint-config": "workspace:*",
    "@englove/prettier-config": "workspace:*",
    "tsup": "^8.4.0",
    "typescript": "~5.9.3",
    "vitest": "^3.0.7",
    "eslint": "^9.21.0"
  }
}
